<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:OpenUtau.App.ViewModels"
        mc:Ignorable="d"
        x:Class="OpenUtau.App.Views.SingerCatalogDialog"
        Icon="/Assets/pmou.png"
        Title="{DynamicResource singercatalog.caption}" Width="540" Height="620"
        WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <vm:SingerCatalogViewModel/>
  </Design.DataContext>
  <Window.Styles>
    <Style Selector="Border.singerRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
    </Style>
    <Style Selector="Border.search">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="10,0,8,0"/>
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Border.search:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}"/>
    </Style>
    <Style Selector="Border.search TextBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.search TextBox /template/ Border#PART_BorderElement, Border.search TextBox:pointerover /template/ Border#PART_BorderElement, Border.search TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Window.Styles>
  <Window.Resources>
    <DataTemplate x:Key="SingerRow">
      <Border Classes="singerRow" Padding="10,9" CornerRadius="6" Background="Transparent">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Border Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="6"
                  ClipToBounds="True" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <Image Source="{Binding Image}" Stretch="UniformToFill" IsVisible="{Binding HasImage}"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Author}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding VersionDisplay}" FontSize="12" Opacity="0.65"
                       VerticalAlignment="Center" IsVisible="{Binding ShowVersion}"/>
            <ProgressBar Width="100" Minimum="0" Maximum="100" Value="{Binding Progress}"
                         IsVisible="{Binding ShowProgress}" VerticalAlignment="Center"/>
            <Button Content="{Binding ActionLabel}" IsEnabled="{Binding CanAction}"
                    IsVisible="{Binding ShowInstallButton}" Click="OnInstallClick" MinWidth="84"/>
            <Button Content="{DynamicResource singercatalog.action.website}"
                    IsVisible="{Binding ShowWebButton}" Click="OnOpenWebClick" MinWidth="84"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="12" RowDefinitions="Auto,*,Auto" Focusable="True" PointerPressed="OnBackgroundPointerPressed">
    <Border Grid.Row="0" Classes="search" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*">
        <PathIcon Grid.Column="0" Width="15" Height="15" Opacity="0.55"
                  VerticalAlignment="Center"
                  Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        <TextBox Grid.Column="1" Text="{Binding SearchText}"
                 Watermark="{DynamicResource singercatalog.search}"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Categories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" Margin="10,4,0,4">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"/>
                <TextBlock Text="{Binding Count, StringFormat=' ({0})'}" FontSize="14" Opacity="0.55"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Singers}" ItemTemplate="{StaticResource SingerRow}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="2,10,2,0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" IsVisible="{Binding HasStatus}"/>
      <Button Grid.Column="1" Content="{DynamicResource singercatalog.refresh}" Command="{Binding RefreshCommand}"/>
    </Grid>
  </Grid>
</Window>
